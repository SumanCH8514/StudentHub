{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studenthub-backend",
  "main": "src/index.js",
  "compatibility_date": "2024-03-01",
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "studenthub"
    }
  ],
  "routes": [
    {
      "pattern": "api.backend.studenthub.sumanonline.com",
      "custom_domain": true
    }
  ]
}
